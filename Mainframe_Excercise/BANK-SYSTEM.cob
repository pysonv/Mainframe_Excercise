IDENTIFICATION DIVISION.
PROGRAM-ID. BANK-SYSTEM.

DATA DIVISION.
WORKING-STORAGE SECTION.

01 CUSTOMER-NAME PIC X(30) VALUE "RAVI".
01 ACCOUNT-NUMBER PIC 9(8) VALUE 12345678.
01 ACCOUNT-TYPE PIC X VALUE "S".
01 OPENING-BALANCE PIC 9(10)V99 VALUE 25000.00.
01 DEPOSIT-AMOUNT PIC 9(10)V99 VALUE 5000.00.
01 WITHDRAWAL-AMOUNT PIC 9(10)V99 VALUE 3000.00.
01 INTEREST-RATE PIC 99 VALUE 6.
01 MONTHS PIC 9 VALUE 12.
01 INTEREST-EARNED PIC 9(10)V99.
01 CLOSING-BALANCE PIC 9(10)V99.
01 MIN-BALANCE PIC 9(10)V99 VALUE 1000.00.
01 SERVICE-CHARGE PIC 9(10)V99 VALUE 100.00.
01 LOAN-AMOUNT PIC 9(10)V99 VALUE 50000.00.
01 LOAN-YEARS PIC 9 VALUE 2.
01 LOAN-INTEREST PIC 9(10)V99.
01 TOTAL-AMOUNT PIC 9(10)V99.
01 COUNT PIC 9 VALUE 0.
01 I PIC 9 VALUE 0.

PROCEDURE DIVISION.

MAIN-PARA.

DISPLAY "CUSTOMER: " CUSTOMER-NAME.
DISPLAY "ACCOUNT: " ACCOUNT-NUMBER.
DISPLAY "ACCOUNT TYPE: " ACCOUNT-TYPE.
DISPLAY "OPENING BALANCE: " OPENING-BALANCE.

ADD DEPOSIT-AMOUNT TO OPENING-BALANCE.
SUBTRACT WITHDRAWAL-AMOUNT FROM OPENING-BALANCE.

COMPUTE INTEREST-EARNED =
    OPENING-BALANCE * INTEREST-RATE * MONTHS / (100 * 12).

ADD INTEREST-EARNED TO OPENING-BALANCE.

IF OPENING-BALANCE < MIN-BALANCE
    SUBTRACT SERVICE-CHARGE FROM OPENING-BALANCE
    DISPLAY "SERVICE CHARGE APPLIED"
END-IF.

DISPLAY "INTEREST EARNED: " INTEREST-EARNED.
DISPLAY "CLOSING BALANCE: " OPENING-BALANCE.

COMPUTE LOAN-INTEREST =
    LOAN-AMOUNT * INTEREST-RATE * LOAN-YEARS / 100.

COMPUTE TOTAL-AMOUNT = LOAN-AMOUNT + LOAN-INTEREST.

DISPLAY "LOAN AMOUNT: " LOAN-AMOUNT.
DISPLAY "LOAN INTEREST: " LOAN-INTEREST.
DISPLAY "TOTAL REPAYABLE: " TOTAL-AMOUNT.

PERFORM VARYING I FROM 1 BY 1 UNTIL I > 5
    COMPUTE TOTAL-AMOUNT = TOTAL-AMOUNT - 10000
    DISPLAY "MONTH " I " BALANCE: " TOTAL-AMOUNT
END-PERFORM.

EVALUATE TRUE
    WHEN OPENING-BALANCE > 30000
        DISPLAY "PREMIUM CUSTOMER"
    WHEN OPENING-BALANCE > 15000
        DISPLAY "STANDARD CUSTOMER"
    WHEN OTHER
        DISPLAY "BASIC CUSTOMER"
END-EVALUATE.

DISPLAY "PROGRAM COMPLETE".

STOP RUN.