IDENTIFICATION DIVISION.
PROGRAM-ID. BANK-SUMMARY.

DATA DIVISION.
WORKING-STORAGE SECTION.

01 TRANSACTION-COUNT       PIC 9(6).
01 BRANCH-INDEX            PIC 9(6) COMP.
01 BRANCH-COUNT            PIC 9(6) COMP VALUE 0.

01 INPUT-LINE              PIC X(100).
01 INPUT-BRANCH            PIC X(3).
01 TRANSACTION-TYPE        PIC X.
01 AMOUNT-TEXT             PIC X(30).
01 TRANSACTION-AMOUNT      PIC 9(9)V99.

01 BRANCH-TABLE.
   05 BRANCH-RECORD OCCURS 100000 TIMES.
      10 BRANCH-ID         PIC X(3).
      10 DEPOSIT-TOTAL     PIC 9(14)V99.
      10 WITHDRAWAL-TOTAL  PIC 9(14)V99.

01 BANK-DEPOSIT-TOTAL      PIC 9(14)V99 VALUE 0.
01 BANK-WITHDRAWAL-TOTAL   PIC 9(14)V99 VALUE 0.

01 NET-FLOW                PIC S9(14)V99.

01 DISPLAY-DEPOSITS       PIC Z(13)9.99.
01 DISPLAY-WITHDRAWALS    PIC Z(13)9.99.
01 DISPLAY-NET             PIC -(13)9.99.

PROCEDURE DIVISION.

MAIN-PARA.

    ACCEPT INPUT-LINE
    COMPUTE TRANSACTION-COUNT =
        FUNCTION NUMVAL(INPUT-LINE)

    PERFORM TRANSACTION-COUNT TIMES

        ACCEPT INPUT-LINE

        UNSTRING INPUT-LINE
            DELIMITED BY ALL SPACES
            INTO INPUT-BRANCH
                 TRANSACTION-TYPE
                 AMOUNT-TEXT
        END-UNSTRING

        COMPUTE TRANSACTION-AMOUNT =
            FUNCTION NUMVAL(AMOUNT-TEXT)

        MOVE 1 TO BRANCH-INDEX

        PERFORM UNTIL BRANCH-INDEX > BRANCH-COUNT
            OR BRANCH-ID(BRANCH-INDEX) = INPUT-BRANCH

            ADD 1 TO BRANCH-INDEX

        END-PERFORM

        IF BRANCH-INDEX > BRANCH-COUNT

            ADD 1 TO BRANCH-COUNT

            MOVE INPUT-BRANCH
                TO BRANCH-ID(BRANCH-INDEX)

            MOVE ZERO TO DEPOSIT-TOTAL(BRANCH-INDEX)
                          WITHDRAWAL-TOTAL(BRANCH-INDEX)

        END-IF

        IF TRANSACTION-TYPE = "D"

            ADD TRANSACTION-AMOUNT
                TO DEPOSIT-TOTAL(BRANCH-INDEX)

        ELSE IF TRANSACTION-TYPE = "W"

            ADD TRANSACTION-AMOUNT
                TO WITHDRAWAL-TOTAL(BRANCH-INDEX)

        END-IF
        END-IF

    END-PERFORM

    PERFORM VARYING BRANCH-INDEX FROM 1 BY 1
        UNTIL BRANCH-INDEX > BRANCH-COUNT

        COMPUTE NET-FLOW =
            DEPOSIT-TOTAL(BRANCH-INDEX)
            - WITHDRAWAL-TOTAL(BRANCH-INDEX)

        MOVE DEPOSIT-TOTAL(BRANCH-INDEX)
            TO DISPLAY-DEPOSITS

        MOVE WITHDRAWAL-TOTAL(BRANCH-INDEX)
            TO DISPLAY-WITHDRAWALS

        MOVE NET-FLOW TO DISPLAY-NET

        DISPLAY "Branch " BRANCH-ID(BRANCH-INDEX)
            ": Deposits " FUNCTION TRIM(DISPLAY-DEPOSITS)
            ", Withdrawals "
            FUNCTION TRIM(DISPLAY-WITHDRAWALS)
            ", Net " FUNCTION TRIM(DISPLAY-NET)

        ADD DEPOSIT-TOTAL(BRANCH-INDEX)
            TO BANK-DEPOSIT-TOTAL

        ADD WITHDRAWAL-TOTAL(BRANCH-INDEX)
            TO BANK-WITHDRAWAL-TOTAL

    END-PERFORM

    COMPUTE NET-FLOW =
        BANK-DEPOSIT-TOTAL - BANK-WITHDRAWAL-TOTAL

    MOVE BANK-DEPOSIT-TOTAL TO DISPLAY-DEPOSITS
    MOVE BANK-WITHDRAWAL-TOTAL TO DISPLAY-WITHDRAWALS
    MOVE NET-FLOW TO DISPLAY-NET

    DISPLAY "Bank total: Deposits "
        FUNCTION TRIM(DISPLAY-DEPOSITS)
        ", Withdrawals " FUNCTION TRIM(DISPLAY-WITHDRAWALS)
        ", Net " FUNCTION TRIM(DISPLAY-NET)

    STOP RUN.
